{
  "name": "@wordlift/ai-audit-webmcp",
  "version": "0.1.0",
  "private": false,
  "description": "Map the actions a website should expose to AI agents and turn gaps into WebMCP-ready contracts.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsc -p tsconfig.server.json && node --enable-source-maps dist-server/server/index.js",
    "dev:demo": "AUDIT_PROVIDER=fixtures REPORT_STORE=memory CLASSIFIER_PROVIDER=fixtures npm run dev",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:webmcp": "vitest run tests/component/webmcp-tools.test.tsx tests/component/alpina-webmcp-tool.test.tsx",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "verify": "npm run typecheck && npm test -- --run && npm run build"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.0",
    "@google-cloud/language": "^7.2.0",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.577.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "use-webmcp-tool": "0.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/jsonld": "^1.5.15",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "jsonld": "^9.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
