# Open demo mode works without external credentials.
AUDIT_PROVIDER=fixtures
REPORT_STORE=memory
CLASSIFIER_PROVIDER=fixtures
SCRAPE_PROVIDER=fixtures
PUBLIC_APP_URL=http://localhost:3000
ACTION_MODEL_VERSION=0.1.0
REPORT_TTL_DAYS=30

# Domain verification for the OpenAI app directory. Unset means /.well-known/openai-apps-challenge
# is not served at all.
# OPENAI_APPS_CHALLENGE=

# Deep-scan report delivery through the AI Audit's existing HubSpot form. Set both or neither.
# HUBSPOT_PORTAL_ID=
# HUBSPOT_FORM_GUID=
# HUBSPOT_REGION=eu1                  # na1 (default) or eu1 for an EU-hosted portal
# HUBSPOT_SOURCE_FIELD=audit_source   # only once the property exists on the form

# Live WordLift mode — keep real values in Secret Manager or an ignored .env, never in git.
# AUDIT_PROVIDER=wordlift
# AI_AUDIT_BASE_URL=https://api.wordlift.io
# WORDLIFT_API_KEY=
# SCRAPE_PROVIDER=native-fetch          # or scrapingbee for rendered collection
# SCRAPINGBEE_API_KEY=
# CLASSIFIER_PROVIDER=google-nlp
# GOOGLE_CLOUD_PROJECT=
# REPORT_STORE=firestore

# Hosted assistants (claude.ai, ChatGPT) call from published egress ranges shared by all their
# users; those draw on a pool per platform instead of one address's budget. Anthropic's range and
# a snapshot of OpenAI's are built in. Add a platform or a newer range here as platform=cidr,
# comma separated; 0 minutes keeps the built-in OpenAI snapshot instead of re-reading it.
# PLATFORM_EGRESS_RANGES=
# PLATFORM_EGRESS_REFRESH_MINUTES=360
